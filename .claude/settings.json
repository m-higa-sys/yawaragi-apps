{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git status)", "Bash(git diff *)", "Bash(git log *)",
      "Bash(git show *)", "Bash(git fetch *)", "Bash(git fetch)", "Bash(git rev-parse *)",
      "Bash(git branch)", "Bash(git checkout *)", "Bash(git commit *)", "Bash(git merge *)",
      "Bash(git rebase *)", "Bash(git merge-base *)", "Bash(git stash *)", "Bash(git pull *)",
      "Bash(git config *)", "Bash(git worktree add *)", "Bash(git worktree list)",
      "Bash(git worktree prune)", "Bash(git worktree remove *)", "Bash(git branch -d *)",
      "Bash(node *)", "Bash(npm run *)", "Bash(npm test *)", "Bash(npm install)", "Bash(npm ci)", "Bash(npx *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(grep *)", "Bash(find *)", "Bash(pwd)", "Bash(echo *)",
      "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(clasp pull *)", "Bash(clasp status *)"
    ],
    "deny": [
      "Bash(git push *)", "Bash(clasp push *)", "Bash(clasp deploy *)",
      "Bash(node scripts/bump-app-version.js *)",
      "Bash(rm *)", "Bash(git branch -D *)"
    ]
  }
}
